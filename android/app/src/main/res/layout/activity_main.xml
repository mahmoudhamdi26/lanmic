<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071018"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:text="LanMic"
        android:textColor="#E8F1F8"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="-28dp"
        android:background="#13202C"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Idle"
        android:textColor="#F5C14A"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Phone microphone"
        android:textColor="#E8F1F8"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Streams this phone to the Ubuntu LanMic input over Wi-Fi. No ads, no time limit."
        android:textColor="#8AA0B3" />

    <EditText
        android:id="@+id/host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="#101A24"
        android:hint="PC IP address"
        android:inputType="text"
        android:padding="14dp"
        android:text="192.168.8.81"
        android:textColor="#E8F1F8"
        android:textColorHint="#8AA0B3" />

    <EditText
        android:id="@+id/port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#101A24"
        android:hint="Port"
        android:inputType="number"
        android:padding="14dp"
        android:text="8767"
        android:textColor="#E8F1F8"
        android:textColorHint="#8AA0B3" />

    <Button
        android:id="@+id/start"
        android:layout_width="176dp"
        android:layout_height="176dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#1A4A38"
        android:text="Start"
        android:textAllCaps="false"
        android:textSize="18sp" />

    <ProgressBar
        android:id="@+id/level"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="24dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Use port 8767 (plain WebSocket). Keep the app open or in the notification shade."
        android:textColor="#8AA0B3" />
</LinearLayout>
